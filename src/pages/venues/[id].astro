---
import { getCollection, render } from 'astro:content';
import { publishedVenues, venueSlug } from '../../lib/venues';
import VenueLayout from '../../layouts/VenueLayout.astro';
export async function getStaticPaths() {
  const venues = publishedVenues(await getCollection('venues'));
  return venues.map(venue => ({ params: { id: venueSlug(venue) }, props: { venue } }));
}
const { venue } = Astro.props;
const { Content } = await render(venue);
---
<VenueLayout venue={venue}><Content /></VenueLayout>
