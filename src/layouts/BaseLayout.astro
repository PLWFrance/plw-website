---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | Perfect Little Wedding</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="prototype-note">A first look · Website prototype · All venue content is fictional</div>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Perfect Little Wedding home"><span class="monogram">PLW<span aria-hidden="true">✳</span></span><span>Perfect Little Wedding</span></a>
      <nav aria-label="Main navigation">
        <a href="/#approach">The approach</a><a href="/#venues">Venues</a><a href="/#next-chapter">Your next chapter</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="wrap footer-inner"><div><a class="footer-brand" href="/">Perfect Little Wedding</a><p>Intimate weddings. France. You.</p></div><div><a href="/venues/maison-des-oliviers/">Explore the sample venue ↗</a><p>Prototype for review · No bookings or enquiries collected.</p></div></div></footer>
  </body>
</html>
