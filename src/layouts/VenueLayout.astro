---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
interface Props { venue: CollectionEntry<'venues'>; }
const { venue: { data } } = Astro.props;
---
<BaseLayout title={`${data.name}${data.fictional ? ' — fictional sample' : ''}`} description={data.summary}>
  <article class="wrap venue-detail">
    <a class="text-link" href="/#venues">← Back to venues</a>
    <header class="venue-title">{data.fictional && <span class="tag">Fictional sample venue · Not available to book</span>}<p class="eyebrow">{data.region}</p><h1>{data.name}</h1><p class="intro">{data.summary}</p></header>
    <PlaceholderImage src={data.image} alt={data.imageAlt} eager />
    <div class="venue-body"><aside aria-label="Illustrative venue details"><p class="eyebrow">At a glance</p><dl><dt>Setting</dt><dd>{data.setting}</dd><dt>Atmosphere</dt><dd>{data.atmosphere}</dd><dt>Booking information</dt><dd>Not applicable to this fictional sample</dd></dl></aside><div class="prose"><slot /></div></div>
  </article>
</BaseLayout>
