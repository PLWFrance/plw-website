---
interface Props { src: string; alt: string; eager?: boolean; placeholder?: boolean; caption?: string; }
const { src, alt, eager = false, placeholder = true, caption } = Astro.props;
---
<figure class="placeholder">
  <img src={src} alt={alt} width="1200" height="1000" loading={eager ? 'eager' : 'lazy'} />
  {(placeholder || caption) && <figcaption>{placeholder && 'Placeholder illustration · not a real venue'}{placeholder && caption && ' · '}{caption}</figcaption>}
</figure>
